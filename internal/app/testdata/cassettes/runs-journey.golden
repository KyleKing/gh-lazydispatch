\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"run_attempt\":1,\"referenced_workflows\":[],\"run_started_at\":\"2026-09-01T04:06:00Z\",\"triggering_actor\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"jobs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33468578418/jobs\",\"logs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33468578418/logs\",\"check_suite_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/check-suites/90689156030\",\"artifacts_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33468578418/artifacts\",\"cancel_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33468578418/cancel\",\"rerun_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33468578418/rerun\",\"previous_attempt_url\":null,\"workflow_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/workflows/223593140\",\"head_commit\":{\"id\":\"4f71f586a0ea1d19fe4fee511a74e0c143ce25d9\",\"tree_id\":\"ba515e7a3e61338e4b062430bf13f9f1c192ab87\",\"message\":\"test(logs): replay recorded gh output instead of trusting hand-written fixtures\\n\\nThe log parser shipped broken because every fixture was written in the shape its\\nauthor pictured rather than the shape gh emits, so a parser built on the same\\nbelief passed its tests and found nothing in production.\\n\\ninternal/ghcassette, ported from second-look, builds a stand-in gh and puts it\\nahead of the real one on PATH. Every run, job, and log read here is\\nexec.CommandExecutor shelling out to gh, so that PATH is the seam; Apply points\\nthis process's own calls at a cassette, since the packages call gh directly\\nrather than through a subprocess of the built binary.\\n\\nTwo cassettes are recorded against completed runs of the dispatch-only demo\\nworkflows, and TestRecorded_ replays them offline through the whole pipeline:\\nfetch, parse, filter, detect, export. Each fails against the bug it was written\\nfor -- the group-marker split, the stamped timestamp, the surviving escapes.\\nTestRecorded_FixturesMatchTheRecordedShape holds every remaining fixture to the\\nrecorded line shape, so a new one cannot be written in a format gh never emits.\\n\\nTestUpdate_AsyncMessagesReachTheirHandlersBehindAModal pins the routing that\\nlet a chain's status modal miss its own updates.\\n\\ncheck-test-safety.sh exempts a file that routes gh through a cassette, since a\\nreal executor there reaches the recording and never GitHub; it still rejects one\\nanywhere else.\",\"timestamp\":\"2026-09-01T04:05:43Z\",\"author\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"},\"committer\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"}},\"repository\":{\"id\":1133962745,\"node_id\":\"R_kgDOQ5bl-Q\",\"name\":\"gh-lazydispatch\",\"full_name\":\"KyleKing/gh-lazydispatch\",\"private\":false,\"owner\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"html_url\":\"https://github.com/KyleKing/gh-lazydispatch\",\"description\":\"Interactive GitHub Workflow Dispatcher (standalone or with the GH CLI)\",\"fork\":false,\"url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch\",\"forks_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/forks\",\"keys_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/keys{/key_id}\",\"collaborators_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/collaborators{/collaborator}\",\"teams_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/teams\",\"hooks_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/hooks\",\"issue_events_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/issues/events{/number}\",\"events_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/events\",\"assignees_url\":\"https://api.github.com/repos/KyleKing/gh-