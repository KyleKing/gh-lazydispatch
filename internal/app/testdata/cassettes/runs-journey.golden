public\",\"site_admin\":false},\"run_attempt\":1,\"referenced_workflows\":[],\"run_started_at\":\"2026-09-01T20:35:47Z\",\"triggering_actor\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"jobs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556239172/jobs\",\"logs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556239172/logs\",\"check_suite_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/check-suites/90934574291\",\"artifacts_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556239172/artifacts\",\"cancel_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556239172/cancel\",\"rerun_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556239172/rerun\",\"previous_attempt_url\":null,\"workflow_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/workflows/307082200\",\"head_commit\":{\"id\":\"81f5bf786f6b8e05398c8a25eb69fb126c07cf70\",\"tree_id\":\"9a77440b94eb644832d0754796a7342fe9c72919\",\"message\":\"feat(ui): show a branch's real state and give the layout its space back\\n\\nThe right panel hid four tabs' worth of counts behind h/l and the config pane\\ntook half the screen whether it held twenty inputs or none. Driving a\\n26-workflow repository under a PTY turned up why the golden frames had never\\nsaid so: PaneStyle called BorderStyle, which sets a border's style without\\nenabling a side, and nothing outside main applied a theme, so every frame was\\nasserting on a borderless colorless UI no user has seen.\\n\\nThe Runs tab reads the newest run of each workflow off GitHub, which is the\\nquestion the History tab cannot answer in a repository this checkout has never\\ndispatched from. Layout arithmetic now lives in one place, and the config pane\\ntakes the height its content needs, which took the workflow list from 11 rows\\nto 26 at 80x24.\",\"timestamp\":\"2026-09-01T20:35:40Z\",\"author\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"},\"committer\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"}},\"repository\":{\"id\":1133962745,\"node_id\":\"R_kgDOQ5bl-Q\",\"name\":\"gh-lazydispatch\",\"full_name\":\"KyleKing/gh-lazydispatch\",\"private\":false,\"owner\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"