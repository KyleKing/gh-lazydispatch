ydispatch/actions/runs/33556709397\",\"html_url\":\"https://github.com/KyleKing/gh-lazydispatch/actions/runs/33556709397\",\"pull_requests\":[],\"created_at\":\"2026-09-01T20:40:37Z\",\"updated_at\":\"2026-09-01T20:41:04Z\",\"actor\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"run_attempt\":1,\"referenced_workflows\":[],\"run_started_at\":\"2026-09-01T20:40:37Z\",\"triggering_actor\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"jobs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556709397/jobs\",\"logs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556709397/logs\",\"check_suite_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/check-suites/90935885549\",\"artifacts_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556709397/artifacts\",\"cancel_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556709397/cancel\",\"rerun_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33556709397/rerun\",\"previous_attempt_url\":null,\"workflow_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/workflows/307082200\",\"head_commit\":{\"id\":\"11e3d173f51086d3ec4f1c6b18b111394cbf7681\",\"tree_id\":\"481ec5e81ff16217024d6f448c70e8128f0062b0\",\"message\":\"test(chain): make the chain engine testable and cover its failure paths\\n\\nrunStep called runner.ExecuteAndGetRunID directly, which shells out to\\n`gh workflow run`, and internal/exec's mutation guard panics on that during a\\ntest. So the part of the chain engine that decides whether a failed step aborts\\nthe rest had no test, and could not have one. The executor now takes the\\ndispatch and the poll interval as options, which took the package from 45% to\\n78% and pinned abort, continue, and stop.\\n\\nAlso names a run's logs after the run when no workflow name reached them, so\\n`:logs <run-id>` no longer titles the viewer \\\"Logs: \\\".\",\"timestamp\":\"2026-09-01T20:40:31Z\",\"author\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"},\"committer\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"}},\"repository\":{\"id\":1133962745,\"node_id\":\"R_kgDOQ5bl-Q\",\"name\":\"gh-lazydispatch\",\"full_name\":\"KyleKing/gh-lazydispatch\",\"private\":false,\"owner\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"html_url\":\"https://github.com/KyleKing/gh-lazydispatch\",\"description\":\"Interactive GitHub Workflow Dispatcher (standalone or with the GH CLI)\",\"fork\":false,\"url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch\",\"forks_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/forks\",\"keys_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/keys{/key_id}\",\"collaborators_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/collaborators{/collaborator}\",\"teams_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/teams\",\"hooks_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/hooks\",\"issue_events_url\":\"https://api.github.com/repos/Kyl