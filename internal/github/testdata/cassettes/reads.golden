vatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"jobs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33467036043/jobs\",\"logs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33467036043/logs\",\"check_suite_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/check-suites/90685091183\",\"artifacts_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33467036043/artifacts\",\"cancel_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33467036043/cancel\",\"rerun_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/runs/33467036043/rerun\",\"previous_attempt_url\":null,\"workflow_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/actions/workflows/224753415\",\"head_commit\":{\"id\":\"718a9e9582ee7f0391cf2fcff82f01fe94644ce7\",\"tree_id\":\"bd45dcafeb3e0b8c4138bbbe36616f596ae8d57f\",\"message\":\"fix(logs): parse the log format gh actually emits, and let async updates through\\n\\nThe log viewer was empty for every real run. Three causes, each found by driving\\nthe TUI against live workflow runs:\\n\\nUpdate routed every message to the modal stack whenever a modal was open, so\\nChainUpdateMsg, RunUpdateMsg, and the log messages never reached their handlers\\nand their subscriptions were never renewed. A chain's status modal, being the\\nactive modal, could not see its own updates by construction. Background messages\\nnow reach their handler first; that also closes the known defect where a modal's\\nresult was dropped when a keystroke raced it.\\n\\nparseJobLogsIntoSteps split on ##[group] at the start of a line, but\\n'gh run view --log' prefixes every line with 'job\\\\tstep\\\\ttimestamp'. It found no\\nsteps and the viewer showed none. The fixtures were written in the same shape gh\\nnever emits, which is how it stayed green; they now hold real output. Splitting\\nkeys on the step names the job declares, so a message carrying tabs of its own\\ncannot invent a step.\\n\\nEach entry's timestamp was time.Now() while the real one stayed in the text, and\\nGitHub's coloring survived as caret notation, which ansi.Strip cannot see. Both\\nare now lifted out of the content.\\n\\nA chain dispatched from its goroutine also wrote gh's output over the alt\\nscreen.\",\"timestamp\":\"2026-09-01T03:39:35Z\",\"author\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"},\"committer\":{\"name\":\"Kyle King\",\"email\":\"KyleKing@users.noreply.github.com\"}},\"repository\":{\"id\":1133962745,\"node_id\":\"R_kgDOQ5bl-Q\",\"name\":\"gh-lazydispatch\",\"full_name\":\"KyleKing/gh-lazydispatch\",\"private\":false,\"owner\":{\"login\":\"KyleKing\",\"id\":3784339,\"node_id\":\"MDQ6VXNlcjM3ODQzMzk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/3784339?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/KyleKing\",\"html_url\":\"https://github.com/KyleKing\",\"followers_url\":\"https://api.github.com/users/KyleKing/followers\",\"following_url\":\"https://api.github.com/users/KyleKing/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/KyleKing/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/KyleKing/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/KyleKing/subscriptions\",\"organizations_url\":\"https://api.github.com/users/KyleKing/orgs\",\"repos_url\":\"https://api.github.com/users/KyleKing/repos\",\"events_url\":\"https://api.github.com/users/KyleKing/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/KyleKing/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"html_url\":\"https://github.com/KyleKing/gh-lazydispatch\",\"description\":\"Interactive GitHub Workflow Dispatcher (standalone or with the GH CLI)\",\"fork\":false,\"url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch\",\"forks_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/forks\",\"keys_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/keys{/key_id}\",\"collaborators_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/collaborators{/collaborator}\",\"teams_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/teams\",\"hooks_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/hooks\",\"issue_events_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/issues/events{/number}\",\"events_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/events\",\"assignees_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/assignees{/user}\",\"branches_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/branches{/branch}\",\"tags_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/tags\",\"blobs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/git/blobs{/sha}\",\"git_tags_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/git/tags{/sha}\",\"git_refs_url\":\"https://api.github.com/repos/KyleKing/gh-lazydispatch/git/refs{/sha}\",\"trees_url\":\"https://api.github.